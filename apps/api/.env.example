# Hi! Platform — Backend — Template (copier vers .env et remplir)

DATABASE_URL=sqlite+aiosqlite:///./hiplatform.db
# Prod: DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

SECRET_KEY=GENERATE_WITH_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ALLOWED_DOMAINS=polytechnique.edu,telecom-paris.fr,hec.fr,ensae.fr

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_YOUR_RESEND_API_KEY

FRONTEND_URL=http://localhost:3000
# Prod: FRONTEND_URL=https://your-app.vercel.app

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
